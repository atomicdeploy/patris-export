{
  "canonical": {
    "enabled": true,
    "source_id": "patris-office",
    "profiles": {
      "kala.db": {
        "type": "kala_v1"
      }
    }
  },
  "send_updates": {
    "enabled": true,
    "url": "https://receiver.example/wp-json/receiver/patris/product-sync",
    "method": "POST",
    "format": "json",
    "mode": "changes",
    "initial": true,
    "allow_raw": false,
    "require_contract": true,
    "timeout": "10s",
    "retry_attempts": 3,
    "retry_backoff": "2s",
    "product_sync_secret_env": "PATRIS_PRODUCT_SYNC_SECRET",
    "headers": {
      "X-Integration-Name": "patris-office"
    }
  }
}
